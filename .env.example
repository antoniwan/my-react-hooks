# Example environment file for my-react-hooks
# Copy this to ".env.local" (ignored by git) and adjust as needed.
#
# Vite only exposes variables prefixed with "VITE_".

# Public URL for the GitHub repository shown in the footer and demos
VITE_SITE_REPO_URL=https://github.com/zombi/my-react-hooks

#
# OpenWeatherMap API key used by the useUserContext demo
# Sign up at https://openweathermap.org/ for a free API key.
# If omitted, weather lookups are disabled and the demo will show "Disabled (no API key)".
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

#
# Optional: override the default ipapi endpoint used for geo lookups.
# The default is "https://ipapi.co/json/" if this is not set.
# VITE_IPAPI_ENDPOINT=https://ipapi.co/json/

# Note: site version is taken directly from package.json
# (see vite.config.ts) and does not need an env variable.
