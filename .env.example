# Example environment file for my-react-hooks
# Copy this to ".env.local" (ignored by git) and adjust as needed.
#
# Vite only exposes variables prefixed with "VITE_".

# Public URL for the GitHub repository shown in the footer and demos
VITE_SITE_REPO_URL=https://github.com/zombi/my-react-hooks

# Note: site version is taken directly from package.json
# (see vite.config.ts) and does not need an env variable.

